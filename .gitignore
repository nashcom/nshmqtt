# Build artifacts (see Makefile: SRCS := $(wildcard src/*.cpp), -MMD -MP)
*.o
*.d

# Compiled binaries
/nshmqtt
tests/test_nshmqtt

# docker/compile_alpine.sh's own output lands here too, already covered by
# *.o above.

# Stray test/run output
tests/*.log

# mosquitto/config is real, tracked config; data/log under it are runtime
# state -- normally never even written here at all (docker-compose.yml
# mounts named volumes for both, not these local paths), but ignored
# defensively in case something (a local, non-Docker mosquitto run) ever
# writes here directly.
mosquitto/data/*
mosquitto/log/*

# Generated by gen-cert.sh -- local test CA + leaf, private keys included.
# Never commit any of this even though it's test-only: the CA key signs
# anything a client is told to trust, and getting into the habit of
# committing key material is exactly the mistake that costs you on a real
# one. tls/README.md is deliberately excepted -- it's a plain doc file,
# not generated, and has nothing to do with the actual key material this
# rule exists to keep out (ignoring the directory's *contents* rather
# than the directory itself is what makes that exception possible at
# all -- a bare "/tls/" can't be un-ignored file-by-file).
tls/*
!tls/README.md
.env

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS cruft
.DS_Store
Thumbs.db
